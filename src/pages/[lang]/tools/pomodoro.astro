---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PomodoroTimer from '../../../components/interactive/PomodoroTimer.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('tools.pomodoro')} description={t('tools.pomodoroDesc')}>
  <div class="container-narrow page">
    <h1>{t('tools.pomodoro')}</h1>
    <p class="sub">{t('tools.pomodoroDesc')}</p>
    <PomodoroTimer lang={lang} />
  </div>
</BaseLayout>
<style>
  .page { padding-top: 2.5rem; max-width: 560px; }
  h1 { font-size: clamp(2rem, 4vw, 2.6rem); margin-bottom: 0.3rem; text-align: center; }
  .sub { color: var(--text-soft); text-align: center; margin: 0; }
</style>
