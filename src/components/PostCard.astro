---
import { formatDate, localePath, type Lang } from '../i18n/ui';
import { splitId, type Post } from '../lib';
interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const { slug } = splitId(post.id);
---
<article class="card">
  <a href={localePath(lang, `/blog/${slug}`)}>
    {post.data.kicker && <span class="kicker">{post.data.kicker}</span>}
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
  </a>
</article>
<style>
  .card a {
    display: block;
    height: 100%;
    padding: 1.25rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--accent);
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--warm);
  }
  h3 {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.25rem;
  }
  p {
    margin: 0 0 0.75rem;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  time {
    font-size: 0.85rem;
    color: var(--text-soft);
  }
</style>
