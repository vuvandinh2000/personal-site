---
/**
 * Hand-drawn SVG illustrations that follow the site theme (light + dark).
 * Usage in MDX: <Illustration name="brick-wall" caption="..." />
 */
interface Props {
  name: 'brain-gym' | 'feels-vs-works' | 'brick-wall' | 'zombie' | 'sleep' | 'chunk' | 'venn' | 'crossroads';
  caption?: string;
  labels?: string[];
}
const { name, caption, labels = [] } = Astro.props;
---
<figure class:list={['illo', name]}>
  {
    name === 'brain-gym' && (
      <svg viewBox="0 0 640 300" role="img" aria-label={caption ?? 'A brain lifting a dumbbell'}>
        <ellipse cx="320" cy="270" rx="230" ry="16" fill="var(--bg-soft)" />
        <g>
          <path d="M240 150c-40 0-56-46-26-70-8-40 34-62 62-44 14-30 66-30 82 0 32-16 70 8 62 44 32 20 20 72-22 72-4 34-54 46-78 22-26 24-78 12-80-24Z" fill="#f4a6b7" stroke="#b9506a" stroke-width="5" stroke-linejoin="round" />
          <path d="M270 92c14 8 18 22 10 34M330 70c-6 22 6 34 24 36M300 140c10-10 28-10 38 2M372 128c-12 0-20 10-18 22" fill="none" stroke="#b9506a" stroke-width="4.5" stroke-linecap="round" />
          <circle cx="292" cy="118" r="7" fill="#3a2a2a" />
          <circle cx="352" cy="118" r="7" fill="#3a2a2a" />
          <path d="M306 146c8 8 22 8 30 0" fill="none" stroke="#3a2a2a" stroke-width="4" stroke-linecap="round" />
          <path d="M218 150l-40-50M424 150l40-50" stroke="#b9506a" stroke-width="7" stroke-linecap="round" />
          <path d="M240 186l-12 70M398 186l12 70" stroke="#b9506a" stroke-width="7" stroke-linecap="round" />
        </g>
        <g fill="var(--text)">
          <rect x="150" y="84" width="340" height="12" rx="6" />
          <rect x="128" y="58" width="24" height="64" rx="6" />
          <rect x="104" y="66" width="20" height="48" rx="6" />
          <rect x="488" y="58" width="24" height="64" rx="6" />
          <rect x="516" y="66" width="20" height="48" rx="6" />
        </g>
        <path d="M560 60l10-18M580 80l20-6M556 34l-4-20" stroke="var(--warm)" stroke-width="5" stroke-linecap="round" />
        <path d="M80 60l-10-18M60 80l-20-6M84 34l4-20" stroke="var(--warm)" stroke-width="5" stroke-linecap="round" />
      </svg>
    )
  }
  {
    name === 'feels-vs-works' && (
      <svg viewBox="0 0 640 280" role="img" aria-label={caption ?? 'Feels good versus actually works'}>
        <rect x="10" y="10" width="300" height="260" rx="20" fill="var(--warm-soft)" />
        <rect x="330" y="10" width="300" height="260" rx="20" fill="var(--accent-soft)" />
        <text x="160" y="52" text-anchor="middle" font-size="22" font-weight="700" fill="var(--warm)">{labels[0] ?? 'Feels good'}</text>
        <text x="480" y="52" text-anchor="middle" font-size="22" font-weight="700" fill="var(--accent)">{labels[1] ?? 'Actually works'}</text>
        {/* open book + highlighter */}
        <path d="M70 110c30-14 60-14 90 0v110c-30-14-60-14-90 0Z" fill="var(--surface)" stroke="var(--text)" stroke-width="4" stroke-linejoin="round" />
        <path d="M160 110c30-14 60-14 90 0v110c-30-14-60-14-90 0Z" fill="var(--surface)" stroke="var(--text)" stroke-width="4" stroke-linejoin="round" />
        <path d="M84 138h60M84 160h60M176 138h60M176 182h50" stroke="#f5d742" stroke-width="12" stroke-linecap="round" opacity="0.85" />
        <path d="M84 182h40M176 160h60" stroke="var(--text-soft)" stroke-width="3" stroke-linecap="round" />
        <g transform="rotate(-35 240 90)">
          <rect x="214" y="70" width="80" height="24" rx="6" fill="#f5d742" stroke="var(--text)" stroke-width="3.5" />
          <path d="M294 74l18 8-18 8Z" fill="var(--text)" />
        </g>
        {/* blank page + pen + check */}
        <rect x="400" y="86" width="140" height="160" rx="10" fill="var(--surface)" stroke="var(--text)" stroke-width="4" />
        <path d="M420 120c20-6 40 6 60 0s40-6 50 0M420 150c24-6 44 4 70-2M420 180c16-4 30 2 46-2" fill="none" stroke="var(--text)" stroke-width="3.5" stroke-linecap="round" />
        <g transform="rotate(35 560 120)">
          <rect x="540" y="60" width="18" height="110" rx="5" fill="var(--accent)" stroke="var(--text)" stroke-width="3.5" />
          <path d="M540 170l9 20 9-20Z" fill="var(--text)" />
        </g>
        <circle cx="560" cy="226" r="24" fill="var(--accent)" />
        <path d="M548 226l9 9 16-18" fill="none" stroke="var(--accent-ink)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    name === 'brick-wall' && (
      <svg viewBox="0 0 640 260" role="img" aria-label={caption ?? 'Two walls: one built all at once collapses, one built layer by layer stands'}>
        <text x="160" y="30" text-anchor="middle" font-size="20" font-weight="700" fill="var(--bad)">{labels[0] ?? 'Cramming'}</text>
        <text x="480" y="30" text-anchor="middle" font-size="20" font-weight="700" fill="var(--accent)">{labels[1] ?? 'Spaced practice'}</text>
        <line x1="20" y1="240" x2="300" y2="240" stroke="var(--border)" stroke-width="4" />
        <line x1="340" y1="240" x2="620" y2="240" stroke="var(--border)" stroke-width="4" />
        {/* collapsed pile */}
        {[[60, 218, -8], [110, 220, 12], [160, 214, -4], [210, 220, 20], [86, 192, 25], [140, 188, -15], [190, 194, 6], [118, 164, -30], [170, 166, 40]].map(([x, y, r]) => (
          <rect x={x} y={y} width="48" height="20" rx="3" fill="var(--warm)" opacity="0.85" stroke="var(--text)" stroke-width="2.5" transform={`rotate(${r} ${x + 24} ${y + 10})`} />
        ))}
        <path d="M250 150c8-10 20-10 26 0M236 120c10-14 28-14 36 0" fill="none" stroke="var(--text-soft)" stroke-width="3" stroke-linecap="round" />
        {/* neat wall */}
        {[0, 1, 2, 3, 4, 5].map((row) =>
          Array.from({ length: row % 2 ? 4 : 5 }, (_, col) => (
            <rect x={358 + col * 52 + (row % 2) * 26} y={216 - row * 26} width="48" height="22" rx="3" fill="var(--accent)" opacity={0.55 + row * 0.08} stroke="var(--text)" stroke-width="2" />
          )),
        )}
      </svg>
    )
  }
  {
    name === 'zombie' && (
      <svg viewBox="0 0 640 260" role="img" aria-label={caption ?? 'A friendly procrastination zombie holding a phone, next to a tomato timer'}>
        <ellipse cx="200" cy="240" rx="110" ry="12" fill="var(--bg-soft)" />
        <rect x="150" y="110" width="100" height="110" rx="30" fill="#8fbf7f" stroke="var(--text)" stroke-width="4" />
        <circle cx="200" cy="80" r="52" fill="#a8d394" stroke="var(--text)" stroke-width="4" />
        <circle cx="182" cy="76" r="9" fill="var(--surface)" stroke="var(--text)" stroke-width="3" />
        <circle cx="220" cy="72" r="12" fill="var(--surface)" stroke="var(--text)" stroke-width="3" />
        <circle cx="184" cy="78" r="3.5" fill="var(--text)" />
        <circle cx="222" cy="75" r="4" fill="var(--text)" />
        <path d="M184 104c10 6 22 6 32-2" fill="none" stroke="var(--text)" stroke-width="3.5" stroke-linecap="round" />
        <path d="M160 40l10 14M200 28v16M236 36l-8 14" stroke="var(--text)" stroke-width="3.5" stroke-linecap="round" />
        <path d="M150 140c-30 6-50 0-60-10M250 140c30-4 46-20 52-34" fill="none" stroke="var(--text)" stroke-width="10" stroke-linecap="round" />
        <rect x="290" y="70" width="34" height="58" rx="6" fill="var(--text)" transform="rotate(14 307 99)" />
        <rect x="295" y="77" width="24" height="40" rx="3" fill="#7cc4ff" transform="rotate(14 307 99)" />
        <path d="M176 220v20M224 220v20" stroke="var(--text)" stroke-width="10" stroke-linecap="round" />
        {/* tomato */}
        <ellipse cx="480" cy="240" rx="80" ry="10" fill="var(--bg-soft)" />
        <circle cx="480" cy="160" r="72" fill="#e5533d" stroke="var(--text)" stroke-width="4" />
        <path d="M480 92c-10-16-30-18-40-10 14 2 22 8 26 16-16-4-30 2-34 12 16-6 30-4 42 2-6 6-8 16-4 24 6-10 14-16 22-16 2 10 10 16 22 16-4-8-4-16 2-22 12 2 26 0 34-10-14 0-28-2-38-10 6-8 16-12 28-12-12-8-34-4-46 10Z" fill="#4c9a3c" stroke="var(--text)" stroke-width="3" stroke-linejoin="round" />
        <circle cx="480" cy="166" r="40" fill="#fff4ee" stroke="var(--text)" stroke-width="3" />
        <path d="M480 166v-28M480 166l18 10" stroke="var(--text)" stroke-width="4" stroke-linecap="round" />
        <text x="480" y="222" text-anchor="middle" font-size="18" font-weight="700" fill="#fff">25:00</text>
      </svg>
    )
  }
  {
    name === 'sleep' && (
      <svg viewBox="0 0 640 220" role="img" aria-label={caption ?? 'A brain sleeping on a pillow'}>
        <rect x="140" y="140" width="360" height="56" rx="28" fill="var(--accent-soft)" stroke="var(--text)" stroke-width="4" />
        <path d="M240 150c-34 0-46-38-22-58-6-32 28-50 50-36 12-24 54-24 66 0 26-12 56 6 50 36 26 16 16 58-18 58Z" fill="#f4a6b7" stroke="#b9506a" stroke-width="5" stroke-linejoin="round" />
        <path d="M268 108c10 6 14 18 8 28M318 90c-4 18 4 28 20 30M362 104c-10 2-14 12-10 22" fill="none" stroke="#b9506a" stroke-width="4" stroke-linecap="round" />
        <path d="M282 128c6 4 14 4 20 0M330 128c6 4 14 4 20 0" fill="none" stroke="#3a2a2a" stroke-width="4" stroke-linecap="round" />
        <text x="440" y="80" font-size="34" font-weight="700" fill="var(--accent)">Z</text>
        <text x="478" y="52" font-size="26" font-weight="700" fill="var(--accent)" opacity="0.75">z</text>
        <text x="506" y="30" font-size="20" font-weight="700" fill="var(--accent)" opacity="0.5">z</text>
        <path d="M110 40a30 30 0 1 0 34 40 24 24 0 0 1-34-40Z" fill="#f2c14e" />
        <circle cx="560" cy="150" r="4" fill="#f2c14e" /><circle cx="90" cy="150" r="3" fill="#f2c14e" /><circle cx="590" cy="100" r="3" fill="#f2c14e" />
      </svg>
    )
  }
  {
    name === 'chunk' && (
      <svg viewBox="0 0 640 220" role="img" aria-label={caption ?? 'Scattered puzzle pieces becoming one connected chunk'}>
        {[[40, 60, -15], [120, 130, 20], [70, 160, 5], [150, 50, -30]].map(([x, y, r]) => (
          <g transform={`rotate(${r} ${x + 30} ${y + 30})`}>
            <path d={`M${x} ${y}h22a8 8 0 1 1 16 0h22v22a8 8 0 1 1 0 16v22H${x}Z`} fill="var(--warm)" opacity="0.8" stroke="var(--text)" stroke-width="3" />
          </g>
        ))}
        <path d="M250 110h110" stroke="var(--text-soft)" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 12" />
        <path d="M350 96l16 14-16 14" fill="none" stroke="var(--text-soft)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <g stroke="var(--text)" stroke-width="3" fill="var(--accent)">
          <path d="M420 50h50v50h-50Z" opacity="0.7" />
          <path d="M470 50h50v50h-50Z" opacity="0.85" />
          <path d="M420 100h50v50h-50Z" opacity="0.85" />
          <path d="M470 100h50v50h-50Z" opacity="1" />
        </g>
        <rect x="408" y="38" width="124" height="124" rx="16" fill="none" stroke="var(--accent)" stroke-width="4" stroke-dasharray="10 8" />
      </svg>
    )
  }
  {
    name === 'venn' && (
      <svg viewBox="0 0 640 400" role="img" aria-label={caption ?? 'Three overlapping circles: what I love, what I am good at, what is needed'}>
        <circle cx="250" cy="150" r="125" fill="var(--warm)" fill-opacity="0.22" stroke="var(--warm)" stroke-width="3" />
        <circle cx="390" cy="150" r="125" fill="var(--accent)" fill-opacity="0.2" stroke="var(--accent)" stroke-width="3" />
        <circle cx="320" cy="265" r="125" fill="#3d7fc9" fill-opacity="0.18" stroke="#3d7fc9" stroke-width="3" />
        {[[200, 105, 0], [440, 105, 1], [320, 318, 2]].map(([x, y, k]) => (
          <text x={x} y={y} text-anchor="middle" font-size="18" font-weight="700" fill="var(--text)">
            {(labels[k] ?? ['What I|love', 'What I am|good at', 'What is needed|(and pays)'][k]).split('|').map((line, j) => (
              <tspan x={x} dy={j ? 22 : 0}>{line}</tspan>
            ))}
          </text>
        ))}
        <circle cx="320" cy="190" r="34" fill="var(--surface)" stroke="var(--text)" stroke-width="3" />
        <text x="320" y="198" text-anchor="middle" font-size="22">⭐</text>
        <text x="320" y="245" text-anchor="middle" font-size="15" font-weight="700" fill="var(--text)">{labels[3] ?? 'Your path'}</text>
      </svg>
    )
  }
  {
    name === 'crossroads' && (
      <svg viewBox="0 -24 640 284" role="img" aria-label={caption ?? 'A road splitting into several paths'}>
        <path d="M320 250 C320 200 320 180 320 160" stroke="var(--text-soft)" stroke-width="26" stroke-linecap="round" fill="none" opacity="0.35" />
        <path d="M320 165 C300 120 200 100 90 60" stroke="var(--warm)" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M320 165 C310 120 260 80 230 30" stroke="var(--accent)" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M320 165 C320 110 320 70 320 25" stroke="#3d7fc9" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M320 165 C330 120 380 80 410 30" stroke="#a35bc4" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M320 165 C340 120 440 100 550 60" stroke="#c97b3d" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.8" />
        <text x="80" y="45" font-size="30">🎓</text><text x="215" y="22" font-size="28">🛠️</text><text x="305" y="18" font-size="28">🎖️</text>
        <text x="400" y="22" font-size="28">✈️</text><text x="545" y="45" font-size="30">🌏</text>
      </svg>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .illo {
    margin: 2rem 0;
  }
  .illo svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
  figcaption {
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-soft);
    margin-top: 0.6rem;
  }
</style>
