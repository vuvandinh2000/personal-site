---
import { useTranslations, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<footer class="site-footer">
  <div class="container">
    <p>{t('footer.made')}</p>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.9rem;
  }
</style>
