---
import { useTranslations, localePath, switchLangPath, otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Explicit link for the language switch (e.g. when a post has no translation) */
  altHref?: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const switchHref = altHref ?? switchLangPath(Astro.url.pathname, other);
const path = Astro.url.pathname;
const nav = [
  { href: localePath(lang, '/blog'), label: t('nav.blog') },
  { href: localePath(lang, '/series/mentoring'), label: t('nav.mentoring') },
  { href: localePath(lang, '/tools'), label: t('nav.tools') },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang)} aria-label={t('nav.home')}>
      <span class="logo" aria-hidden="true">Đ</span>
      <span class="name">{t('site.title')}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={switchHref} hreflang={other} lang={other} data-lang-switch={other} title={t('lang.switch')}>
        <span class:list={['opt', { on: lang === 'en' }]}>EN</span>
        <span class:list={['opt', { on: lang === 'vi' }]}>VI</span>
      </a>
      <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Remember the chosen language so "/" can send people back to it next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langSwitch || 'en'); } catch {}
    }),
  );
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    root.dataset.theme = isDark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-head);
    font-size: 1.15rem;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    color: var(--text-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-soft);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lang {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    text-decoration: none;
  }
  .opt {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-soft);
  }
  .opt.on {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-soft);
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .bar {
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-block: 0.5rem;
    }
    .name {
      display: none;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
    }
    .actions {
      margin-left: auto;
    }
  }
</style>
